{
  "name": "bootstrap-scaffold",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/require-env.mjs DATABASE_URL && drizzle-kit migrate",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:auth-live": "vitest run --config vitest.auth-live.config.ts",
    "test:db": "node scripts/require-env.mjs TEST_DATABASE_URL && vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.0.0",
    "isbot": "^5.1.36",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.0"
  }
}
